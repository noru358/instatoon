{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru358/instatoon/schemas/render_manifest.schema.json",
  "title": "Instatoon Render Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "episode_id",
    "episode_plan_git_blob_sha",
    "canonical_prompt_source",
    "output",
    "style_refs",
    "renderer_contract",
    "batch_policy",
    "slides"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^E[0-9]{3,}$"
    },
    "episode_plan_git_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "canonical_prompt_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "section_heading"
      ],
      "properties": {
        "path": {
          "const": "MASTER_PROMPTS.md"
        },
        "section_heading": {
          "const": "## 12. COMPILED PRODUCTION PROMPT"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "width",
        "height",
        "text_free_raster"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "text_free_raster": {
          "const": true
        }
      }
    },
    "style_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "renderer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_prompt_bindings",
        "reference_conditioning_modes",
        "required_reference_conditioning",
        "unexpected_concept_policy"
      ],
      "properties": {
        "allowed_prompt_bindings": {
          "type": "array",
          "items": {
            "enum": [
              "EXPLICIT_COMPILED_PAYLOAD",
              "CONVERSATION_INFERRED"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reference_conditioning_modes": {
          "type": "array",
          "items": {
            "enum": [
              "BINARY_CONDITIONED",
              "AUTHORITY_INFORMED_NON_BINARY_CONDITIONED"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unexpected_concept_policy": {
          "const": "FAIL_CLOSED"
        },
        "required_reference_conditioning": {
          "enum": [
            "BINARY_REQUIRED",
            "AUTHORITY_ONLY_ALLOWED"
          ]
        }
      }
    },
    "batch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_payload",
        "conversation_inferred"
      ],
      "properties": {
        "explicit_payload": {
          "const": "FIRST_FRAME_GATE_THEN_BATCH"
        },
        "conversation_inferred": {
          "const": "SEQUENTIAL_EVERY_FRAME_GATE"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "slide_id",
          "scene_contract",
          "required_entities",
          "forbidden_entities"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "slide_id": {
            "type": "string"
          },
          "scene_contract": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "required_entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "forbidden_entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
