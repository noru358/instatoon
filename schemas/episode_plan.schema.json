{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru358/instatoon/schemas/episode_plan.schema.json",
  "title": "Instatoon Episode Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","episode_id","title","status","source","continuity_mode","format","cast","style","slides"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["STORYBOARD_LOCKED","READY_FOR_RASTER","RASTER_IN_PROGRESS","RASTER_COMPLETE","LETTERING","QC","COMPLETE"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance_class","human_seeded","base_url"],
      "properties": {
        "provenance_class": {"type": "string", "minLength": 1},
        "human_seeded": {"type": "boolean"},
        "base_url": {"type": ["string","null"]},
        "notes": {"type": "string"}
      }
    },
    "continuity_mode": {"enum": ["NONE","LIGHT","STRICT_EPISODE"]},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio","width","height","slide_count","text_free_raster"],
      "properties": {
        "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "slide_count": {"type": "integer", "minimum": 1, "maximum": 20},
        "text_free_raster": {"const": true}
      }
    },
    "cast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_cast","episode_only"],
      "properties": {
        "main_cast": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "episode_only": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id","role","appears_in","identity_digest"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "appears_in": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
              "identity_digest": {"type": "string", "minLength": 20}
            }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_version","required_refs","forbidden_legacy_refs"],
      "properties": {
        "style_version": {"type": "string", "minLength": 1},
        "required_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "forbidden_legacy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index","slide_id","role","beat","location","action","scene_facts","story_clarity","required_entities","forbidden_entities","composition"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "slide_id": {"type": "string", "pattern": "^E[0-9]{3,}_S[0-9]{2}$"},
          "role": {"type": "string", "minLength": 1},
          "beat": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "scene_facts": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "story_clarity": {"type": "string", "minLength": 1},
          "required_entities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "forbidden_entities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "composition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
