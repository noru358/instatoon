{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instatoon Lettering Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "episode_plan_git_blob_sha",
    "canvas",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^E\\d+$"
    },
    "episode_plan_git_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "slide_id",
          "items"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "slide_id": {
            "type": "string",
            "pattern": "^E\\d+_S\\d{2}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text_id",
                "kind",
                "text",
                "box"
              ],
              "properties": {
                "text_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "caption",
                    "speech",
                    "chat",
                    "sfx"
                  ]
                },
                "speaker": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "box": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "tail_to": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "font_size": {
                  "type": "integer",
                  "minimum": 24,
                  "maximum": 140
                },
                "min_font_size": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 120
                },
                "padding": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "line_spacing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                },
                "radius": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120
                }
              }
            }
          }
        }
      }
    }
  }
}
